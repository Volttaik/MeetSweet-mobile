# ============================================================================
# EAS build context exclusions.
# NOTE: when .easignore exists it REPLACES .gitignore for the EAS context,
# so everything heavy must be repeated here (node_modules, native dirs, env).
# ============================================================================

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
static-build/
expo-env.d.ts

# Native (regenerated by EAS prebuild)
ios/
android/

# Secrets
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem
.env
.env*.local

# Replit / development-only (not needed to build the app)
.replit
replit.nix
.agents/
.replit.state.json
.antigravity-home/
.npm/
.cache/
.local/
scripts/
server/

# debug / logs
npm-debug.*
yarn-debug.*
yarn-error.*
*.log
.metro-health-check*

# macOS
.DS_Store

# typescript
*.tsbuildinfo
.vercel
