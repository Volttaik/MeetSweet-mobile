# MeetSweet Mobile App — Environment Variables
#
# Copy to .env.local and fill in your values.

# Vercel deployment URL for the Next.js serverless backend.
# All API calls go to: https://<your-url>/api/<route>
# Example: https://meetsweet-server.vercel.app
EXPO_PUBLIC_API_URL=https://meetsweet.space

# Native GIPHY SDK credentials. These are platform-scoped public SDK keys,
# not the server API key. The app selects the Android or iOS key at runtime.
# The native SDK requires a custom Expo development build; Expo Go is not
# supported. Keep the server's GIPHY_API_KEY separate.
EXPO_PUBLIC_GIPHY_ANDROID_SDK_KEY=
EXPO_PUBLIC_GIPHY_IOS_SDK_KEY=
