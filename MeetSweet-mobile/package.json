{
  "name": "meetsweet-mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "EXPO_PACKAGER_PROXY_URL=https://$REPLIT_EXPO_DEV_DOMAIN EXPO_PUBLIC_DOMAIN=$REPLIT_DEV_DOMAIN EXPO_PUBLIC_REPL_ID=$REPL_ID REACT_NATIVE_PACKAGER_HOSTNAME=$REPLIT_DEV_DOMAIN ./node_modules/.bin/expo start --localhost --port ${PORT:-8081}",
    "dev:web": "expo start --web --port ${PORT:-8081}",
    "dev:expo-go": "NODE_OPTIONS=--max-old-space-size=1280 expo start --tunnel --port ${PORT:-8081} --max-workers 1",
    "build": "node scripts/build.js",
    "build:web": "expo export --platform web --output-dir dist",
    "serve": "node server/serve.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@expo/cli": "~55.0.35",
    "@expo/ngrok": "^4.1.0",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "catalog:",
    "@types/react": "~19.2.18",
    "@types/react-dom": "~19.2.4",
    "babel-plugin-react-compiler": "^19.0.0-beta-e993439-20250117",
    "babel-preset-expo": "~55.0.24",
    "expo": "~55.0.29",
    "expo-blur": "~55.0.17",
    "expo-constants": "~55.0.17",
    "expo-font": "~55.0.8",
    "expo-haptics": "~55.0.17",
    "expo-image": "~55.0.11",
    "expo-image-picker": "~55.0.23",
    "expo-linear-gradient": "~55.0.17",
    "expo-linking": "~55.0.17",
    "expo-router": "~55.0.18",
    "expo-splash-screen": "~55.0.24",
    "expo-system-ui": "~55.0.21",
    "expo-web-browser": "~55.0.19",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-gesture-handler": "~2.30.1",
    "react-native-keyboard-controller": "1.20.7",
    "react-native-reanimated": "~4.2.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.7.4",
    "typescript": "~5.9.2"
  },
  "dependencies": {
    "@expo-google-fonts/poppins": "^0.4.1",
    "@kesha-antonov/react-native-chat": "^4.1.0",
    "@tailwindcss/postcss": "^4.3.3",
    "expo": "~55.0.29",
    "expo-av": "^16.0.8",
    "expo-build-properties": "~55.0.17",
    "expo-clipboard": "^55.0.16",
    "expo-device": "^55.0.20",
    "expo-document-picker": "^55.0.16",
    "expo-file-system": "~55.0.25",
    "expo-notifications": "^55.0.26",
    "expo-screen-capture": "~55.0.17",
    "expo-screen-orientation": "^55.0.19",
    "expo-secure-store": "^55.0.17",
    "expo-sqlite": "^55.0.19",
    "expo-video-thumbnails": "~55.0.18",
    "heroui-native": "^1.0.6",
    "phosphor-react-native": "^3.0.6",
    "react-native-video": "6.19.2",
    "tailwindcss": "^4.3.3",
    "uniwind": "^1.10.0"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "expo-av"
        ]
      }
    }
  }
}
