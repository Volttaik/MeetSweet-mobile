 server/app/api/creators/[id]/shorts/route.ts |  6 ++++
 server/app/api/creators/[id]/videos/route.ts |  6 ++++
 server/scripts/migrate.ts                    | 30 +++++++++++---------
 5 files changed, 43 insertions(+), 13 deletions(-)

diff --git a/server/app/api/creators/[id]/posts/route.ts b/server/app/api/creators/[id]/posts/route.ts
index 33a3a9b..97bb38d 100644
--- a/server/app/api/creators/[id]/posts/route.ts
+++ b/server/app/api/creators/[id]/posts/route.ts
@@ -32,6 +32,13 @@ export async function GET(
   const subTier = subRow?.tier ?? null;
   const isOwner = userId === creator.id;
 
+  // Creator-profile access model: content is subscriber-gated on the profile.
+  // An unsubscribed viewer gets no rows at all (free content stays discoverable
+  // in Explore, not on the profile); the owner always sees their own content.
+  if (!isOwner && !isSubscribed) {
+    return ok({ locked: true, posts: [] });
+  }
+
   const rows = await db
     .select({
       id: posts.id,
